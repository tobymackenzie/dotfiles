#!/bin/sh
run(){
	file="$1"
	shift
	cmd="$*"
	if [ -d "$file" ] && [ -d "$file/.git" ]; then
		if [ "$cmd" != '' ]; then
			echo '-------' "$file"
			git -C "$file" "$@"
		else
			basename "$file"
		fi
	elif [ "$cmd" != '' ]; then
		echo "$file not a git repo"
	fi
}
#--treat second+ arguments as paths unless second is an option
if [ $# -gt 1 ] && case "$2" in "-"*) false ;; *) true ;; esac; then
	cmd="$1"
	shift
	for file in "$@"; do
		run "$file" "$cmd"
	done
else
	for file in ./*; do
		run "$file" "$@"
	done
fi
