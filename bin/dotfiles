#!/bin/bash
binPath=$(realpath "$(dirname "${BASH_SOURCE[0]}")")
if [ -z "$1" ]; then
	if [ -e ~/.dotfiles ]; then
		cmd='update'
	else
		cmd='init'
	fi
else
	cmd="$1"
fi
cd "$binPath/.." || exit 1
case $cmd in
	'u'|'up'|'update') #: update dotfiles repository from upstream (ie `git pull`)
		echo 'updating dotfiles'
		git pull --autostash "${@:2}"
	;;
	'h'|'help') #: show help for this command
		echo "Usage: dotfiles <subcommand> [options]"
		echo "dotfiles command must be run with one of the following subcommands"
		grep --color -o "'.*)\(\s*#.*\)\$" "$binPath/dotfiles"
	;;
	'i'|'info') #: show project readme
		less README.md
	;;
	'init'|'install') #: dotfiles install. must run again if any new files are added
		bash "${binPath}/../src/init.sh"
	;;
	'bin'|'commands') #: list bin commands
		cd bin || exit 1
		if [ "$#" -lt 2 ]; then
			ls -1A
		else
			for arg in "${@:2}"; do
				ls -1A "$arg"*
			done
		fi
	;;
	'd'|'diff') #: show git diff of dotfiles repo
		git diff --color-words -w "${@:2}"
	;;
	'e'|'edit'|'vi'|'vim') #: edit dotfiles file
		if [ -z "$EDITOR" ]; then
			EDITOR="vi"
		fi
		"$EDITOR" "${binPath}/../${*:2}"
	;;
	'g'|'git') #: run git command on dotfiles repo
		git "${@:2}"
	;;
	'l'|'ls'|'list') #: list files in dotfiles repo
		ls -1AFh --color "${@:2}"
	;;
	'lint') #: lint shell scripts
		#--lint bin commands
		for file in "${binPath}"/*; do
			shebang="$(head -1 "$file")"
			case "$shebang" in
				'#!'*'bash'*|'#!'*'sh'*)
					shellcheck --color "$file"
				;;
				'#!'*'php'*)
					php -l "$file" 1> /dev/null
				;;
			esac
		done
		#--lint sh compatible conf files
		shellcheck --color -s sh "$TJMDOT/sh/profile"
		for file in "${TJMDOT}/sh/"*.sh; do
			shellcheck --color -s sh "$file"
		done
		for file in "${TJMDOT}/sh/commands/"*.sh; do
			shellcheck --color -s sh "$file"
		done
		for file in "${TJMDOT}/shells/"*.sh; do
			shellcheck --color -s sh "$file"
		done
		#--lint bash conf files
		shellcheck --color -s bash "${TJMDOT}/sh/bashrc" "${TJMDOT}/sh/commands/fs.bash" "$TJMDOT/src/init.sh" "$TJMDOT/vim/bashenv"
		#--lint fish scripts
		if command -v 'fish' > /dev/null; then
			for file in "${TJMDOT}/fish/"*.fish; do
				fish -n "$file"
			done
			for file in "${TJMDOT}/fish/"**/*.fish; do
				fish -n "$file"
			done
		fi
		#--lint zsh conf files
		if command -v 'zsh' > /dev/null; then
			zsh -n "$TJMDOT/zsh/plugins.zsh"
			zsh -n "$TJMDOT/zsh/zshenv"
			zsh -n "$TJMDOT/zsh/zshrc"
		fi
	;;
	's'|'stat'|'status') #: get git status of dotfiles repo
		git status -bs "${@:2}"
	;;
	'test'|'tests') #: run phpunit tests on dotfiles repo
		echo 'running tests'
		bash "${binPath}/../tests/init.sh"
	;;
	'v'|'view'|'less') #: view dotfiles file
		less "${binPath}/../${*:2}"
	;;
	*)
		>&2 echo "Unknown subcommand: $cmd"
		"${binPath}/dotfiles" help
		exit 1
	;;
esac
